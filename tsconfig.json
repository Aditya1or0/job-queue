{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "@core/*": ["packages/core/src/*"]
    }
  },
  "include": [
    "packages/**/*",
    "apps/api/**/*",
    "apps/worker/**/*",
    "apps/producer/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/web"
  ]
}
