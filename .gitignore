# =========================================================================
# Git Ignore - Durable MySQL Delayed Job Queue
# Protects private secrets, build artifacts, node_modules, and system files
# =========================================================================

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets (NEVER COMMIT SENSITIVE SECRETS)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.secret

# Build Outputs & Compiled Assets
dist/
build/
out/
.angular/
.cache/
*.tsbuildinfo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Database & Runtime Data
*.sqlite
*.sqlite3
*.db
mysql_data/
data/
storage/

# System & Agent Logs
*.log
.system_generated/
scratch/
tmp/
temp/
